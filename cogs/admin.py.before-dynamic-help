        e.add_field(name="Members", value=f"👤 `{humans}` humans | 🤖 `{bots}` bots")
        e.add_field(name="Channels", value=f"💬 `{text_ch}` text | 🔊 `{voice_ch}` voice | 📁 `{categories}` categories")
        e.add_field(name="Roles", value=f"`{len(g.roles)}`")
