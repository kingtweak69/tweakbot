# Discord
DISCORD_TOKEN=your_bot_token_here
BOT_PREFIX=!
OWNER_IDS=

# Stop startup if a cog fails to load. Set false only while diagnosing an optional integration.
STRICT_COG_LOADING=true
# Sync slash commands to Discord on every startup. Turn off while iterating and
# use the owner-only `!sync` command instead.
SYNC_COMMANDS_ON_STARTUP=true
# Dangerous: allows the bot owner to execute arbitrary Python on the host.
ENABLE_OWNER_EVAL=false

# Lavalink (music)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Database — PostgreSQL is required for persistent bot/agent state.
# Railway example: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Chat AI — OpenAI-compatible /v1/chat/completions endpoint
# ─────────────────────────────────────────────────────────────────────────────
# Keep your existing FreeLLMAPI/OpenRouter/other compatible endpoint here.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=venice/uncensored
CHAT_MAX_TOKENS=900
CHAT_TEMPERATURE=0.7
CHAT_REQUEST_TIMEOUT=90

# ─────────────────────────────────────────────────────────────────────────────
# Chat scope / cost control
# ─────────────────────────────────────────────────────────────────────────────
# Channels where the bot replies to EVERY message without being addressed.
# Comma-separated channel IDs. Empty = mentions/replies/DMs only.
AI_CHAT_CHANNEL_IDS=
# true opens every readable channel. Expensive and noisy — prefer the allowlist.
AI_AUTO_RESPOND=false
AI_RESPOND_TO_MENTIONS=true
AI_RESPOND_IN_DMS=true
# Max unprompted replies per guild per hour. Mentions and DMs are exempt. 0 = off.
AI_GUILD_HOURLY_LIMIT=120
AI_MENTION_COOLDOWN_SECONDS=8
AI_HISTORY_PAIRS=20
AI_SUMMARY_TRIGGER_MESSAGES=60
AI_SUMMARY_KEEP_MESSAGES=40
AI_MAX_INPUT_CHARS=4000
# Lets the chat model ban/kick/timeout/purge. Still enforces the REQUESTER's
# Discord permissions on every call. Off by default.
AI_MODERATION_TOOLS_ENABLED=false
# Lets normal conversation control Wavelink playback and AI DJ mode.
AI_MUSIC_TOOLS_ENABLED=true
# Lets the AI invoke existing TweakBot commands as the requesting user. This is
# what gives natural-language access to GitHub, Railway, TTS, admin utilities,
# and other loaded cogs while preserving their normal OAuth/permission checks.
AI_COMMAND_TOOLS_ENABLED=false
# Persistent agent jobs. 0 = no configured capability-step cap.
# Coding workspaces are persistent when this directory is mounted on durable storage.
# Railway: attach a Volume and mount it at /data, leaving this as /data/tweakbot-workspaces.
AGENT_WORKSPACE_ROOT=/data/tweakbot-workspaces
AGENT_WORKSPACE_PERSISTENT=true
AGENT_JOB_MAX_STEPS=0
AGENT_MAX_ACTIVE_JOBS=3
AGENT_JOB_POLL_SECONDS=3
AGENT_JOB_MAX_TOKENS=1200
# Keeps unlimited job steps while bounding only the model-facing transcript.
# Full tool-step records remain persisted in PostgreSQL.
AGENT_JOB_COMPACT_AFTER_MESSAGES=48
AGENT_JOB_COMPACT_AFTER_CHARS=60000
AGENT_JOB_COMPACT_KEEP_ROUNDS=6
AGENT_JOB_COMPACT_SUMMARY_CHARS=18000
# Attachment understanding / multimodal preprocessing.
STT_MODEL=whisper-1
AI_MAX_ATTACHMENTS=4
AI_MAX_ATTACHMENT_BYTES=50000000
AI_ATTACHMENT_CONTEXT_CHARS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Images / vision — routed through the OpenAI-compatible endpoint above.
# ─────────────────────────────────────────────────────────────────────────────
STABILITY_API_KEY=
AI_MODEL=gpt-4o
IMAGE_MODEL=gpt-5.4-image-2
VISION_MODEL=qwen3.5-omni-plus

# ─────────────────────────────────────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────────────────────────────────────
# Fallback token, used only by OWNER_IDS. Everyone else runs `!github login`.
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
# Optional. Not needed for Device Flow; only needed for app-owner revocation via GitHub API.
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_PROTECTED_BRANCHES=main,master
GITHUB_ALLOW_PROTECTED_BRANCH_COMMITS=false
GITHUB_ALLOW_PR_MERGE=false

# ─────────────────────────────────────────────────────────────────────────────
# Railway OAuth
# ─────────────────────────────────────────────────────────────────────────────
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
RAILWAY_OAUTH_SCOPES=openid offline_access email profile workspace:viewer project:viewer project:member
OAUTH_PUBLIC_BASE_URL=
OAUTH_CALLBACK_HOST=127.0.0.1
# Local/non-Railway override. Railway provides PORT automatically.
OAUTH_CALLBACK_PORT=8787
# Optional standards-compatible Railway revoke endpoint, if Railway provides one for your OAuth app.
RAILWAY_OAUTH_REVOKE_URL=

# Leveling
XP_PER_MESSAGE_MIN=15
XP_PER_MESSAGE_MAX=25
XP_COOLDOWN_SECONDS=60

# Logging / privacy
LOG_CHANNEL_NAME=bot-logs
MOD_LOG_CHANNEL_NAME=mod-logs
LOG_MESSAGE_CONTENT=false
LOG_ATTACHMENT_NAMES=false

# ── ElevenLabs TTS / Voice Studio ────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_PERFORMANCE_MODEL_ID=eleven_v3
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ── Live voice agent ─────────────────────────────────────────────────────────
# Explicit opt-in per session. Only the user who starts the session is processed.
VOICE_AGENT_SILENCE_SECONDS=1.1
VOICE_AGENT_MAX_UTTERANCE_SECONDS=30
VOICE_AGENT_MIN_UTTERANCE_MS=300
VOICE_AGENT_TEXT_MIRROR=true

# ── Voice Studio ──────────────────────────────────────────────────────────────
VOICE_STUDIO_MAX_INSTRUMENTAL_BYTES=50000000

# AI may never execute destructive bot commands unless explicitly enabled.
AI_DESTRUCTIVE_TOOLS_ENABLED=false

